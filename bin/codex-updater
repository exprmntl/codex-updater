#!/bin/zsh

set -u
setopt NULL_GLOB

readonly TOOL_NAME="codex-updater"
readonly TOOL_VERSION="0.2.1"

readonly APP_PATH="${CODEX_UPDATE_HELPER_APP_PATH:-/Applications/ChatGPT.app}"
readonly APP_INFO="$APP_PATH/Contents/Info.plist"
readonly APP_NAME="${APP_PATH:t}"
readonly BUNDLE_ID="${CODEX_UPDATE_HELPER_BUNDLE_ID:-com.openai.codex}"
readonly APP_PROCESS="${CODEX_UPDATE_HELPER_PROCESS_NAME:-ChatGPT}"
readonly APP_EXECUTABLE="${CODEX_UPDATE_HELPER_EXECUTABLE_PATH:-$APP_PATH/Contents/MacOS/$APP_PROCESS}"
readonly EXPECTED_TEAM_ID="${CODEX_UPDATE_HELPER_EXPECTED_TEAM_ID:-2DC432GLL2}"
readonly SPARKLE_INSTALL_DIR="${CODEX_UPDATE_HELPER_SPARKLE_DIR:-$HOME/Library/Caches/com.openai.codex/org.sparkle-project.Sparkle/Installation}"
MIN_IDLE_SECONDS="${CODEX_UPDATE_HELPER_MIN_IDLE_SECONDS:-900}"
readonly MAX_WAIT_SECONDS="${CODEX_UPDATE_HELPER_MAX_WAIT_SECONDS:-600}"
readonly POLL_SECONDS="${CODEX_UPDATE_HELPER_POLL_SECONDS:-5}"
readonly SKIP_SIGNATURE_CHECK="${CODEX_UPDATE_HELPER_SKIP_SIGNATURE_CHECK:-0}"
UPDATE_TIMEZONE="${CODEX_UPDATE_HELPER_TIMEZONE:-America/New_York}"
UPDATE_START_TIME=02:00
UPDATE_END_TIME=03:00
RESTART_POLICY=idle-only
REOPEN=true
RETRY_MINUTES=15
readonly SETTINGS_PATH="${CODEX_UPDATE_HELPER_SETTINGS_PATH:-$HOME/Library/Application Support/Codex Update Helper/settings.plist}"
readonly CHECK_STATE="${CODEX_UPDATE_HELPER_CHECK_STATE:-$HOME/Library/Application Support/Codex Update Helper/last-check}"
# Keep using an older installation until the renamed app is installed.
default_quit_helper="$HOME/Applications/Codex Updater.app/Contents/MacOS/codex-update-helper-quit"
if [[ ! -x $default_quit_helper ]]; then
  default_quit_helper="$HOME/Applications/Codex Update Helper.app/Contents/MacOS/codex-update-helper-quit"
fi
readonly QUIT_HELPER="${CODEX_UPDATE_HELPER_QUIT_HELPER:-$default_quit_helper}"
unset default_quit_helper
readonly SERVICE_LABEL="dev.exprmntl.codex-update-helper"
# Share the lock with older versions so two names cannot run updates together.
readonly LOCK_DIR="${TMPDIR:-/tmp}/codex-update-helper-${UID}.lock"

DRY_RUN=false
FORCE=false
SCHEDULED=false
LOCK_HELD=false
STAGED_APP=""
STAGED_INFO=""
STAGED_BUILD=0
STAGED_VERSION=""

timestamp() {
  /bin/date '+%Y-%m-%d %H:%M:%S %Z'
}

log_info() {
  /bin/echo "$(timestamp) $*"
}

log_error() {
  /bin/echo "$(timestamp) ERROR: $*" >&2
}

usage() {
  /bin/cat <<'USAGE'
Usage:
  codex-updater run [--dry-run] [--force]
  codex-updater status
  codex-updater doctor
  codex-updater settings
  codex-updater config [show|set KEY VALUE ...|reset]
  codex-updater version
  codex-updater help

Commands:
  run       Enable Codex automatic updates and install a signed staged update.
  status    Show installed, staged, preference, process, and service state.
  doctor    Validate the app, signatures, updater cache, and service setup.
  settings  Open the settings window.
  config    Show, change, or reset persistent settings (changes apply next check).

Options for run:
  --dry-run Show what would happen without changing preferences or quitting Codex.
  --force   Bypass the time and idle guards; keep the configured restart policy.

Automatic updates run only from 02:00 to 03:00 America/New_York by default.
Settings: start-time, end-time, timezone, idle-minutes, retry-minutes,
          restart-policy (idle-only or always), reopen (true or false).
USAGE
}

load_settings() {
  local values
  local -a fields
  if [[ -x $QUIT_HELPER ]]; then
    values=$("$QUIT_HELPER" --config values) || { log_error 'Invalid settings; update canceled.'; return 1; }
    fields=("${(@f)values}")
    if (( ${#fields} != 7 )); then log_error 'Could not read settings from the native helper.'; return 1; fi
    UPDATE_TIMEZONE=$fields[1]
    UPDATE_START_TIME=$fields[2]
    UPDATE_END_TIME=$fields[3]
    MIN_IDLE_SECONDS=$(( 10#$fields[4] * 60 ))
    RESTART_POLICY=$fields[5]
    REOPEN=$fields[6]
    RETRY_MINUTES=$fields[7]
  elif [[ -e $SETTINGS_PATH ]]; then
    log_error 'Saved settings exist but the native helper is missing; reinstall the helper.'
    return 1
  fi
  # Keep existing environment overrides for development and older deployments.
  UPDATE_TIMEZONE=${CODEX_UPDATE_HELPER_TIMEZONE:-$UPDATE_TIMEZONE}
  MIN_IDLE_SECONDS=${CODEX_UPDATE_HELPER_MIN_IDLE_SECONDS:-$MIN_IDLE_SECONDS}
  if [[ -n ${CODEX_UPDATE_HELPER_START_HOUR:-} ]]; then
    printf -v UPDATE_START_TIME '%02d:00' "$CODEX_UPDATE_HELPER_START_HOUR"
  fi
  if [[ -n ${CODEX_UPDATE_HELPER_END_HOUR:-} ]]; then
    printf -v UPDATE_END_TIME '%02d:00' "$CODEX_UPDATE_HELPER_END_HOUR"
  fi
}

current_update_time() {
  TZ="$UPDATE_TIMEZONE" /bin/date +%H:%M
}

time_minutes() {
  local value=$1
  [[ $value == [0-2][0-9]:[0-5][0-9] ]] || return 1
  local hour=${value%:*} minute=${value#*:}
  (( 10#$hour < 24 )) || [[ $value == 24:00 ]] || return 1
  /bin/echo $(( 10#$hour * 60 + 10#$minute ))
}

in_update_window() {
  local current start end
  if [[ ! -f /usr/share/zoneinfo/$UPDATE_TIMEZONE ]] \
      || ! start=$(time_minutes "$UPDATE_START_TIME") || ! end=$(time_minutes "$UPDATE_END_TIME") \
      || (( start == end || start >= 1440 )); then
    log_error "Invalid update timezone or window; refusing an automatic restart."
    return 2
  fi
  current=$(time_minutes "$(current_update_time)") || return 2
  if (( start < end )); then
    (( current >= start && current < end ))
  else
    (( current >= start || current < end ))
  fi
}

scheduled_check_due() {
  [[ $SCHEDULED == true && $DRY_RUN != true ]] || return 0
  local now previous=0 previous_settings='' snapshot
  snapshot="$UPDATE_TIMEZONE|$UPDATE_START_TIME|$UPDATE_END_TIME|$MIN_IDLE_SECONDS|$RESTART_POLICY|$REOPEN|$RETRY_MINUTES"
  now=$(/bin/date +%s)
  if [[ -r $CHECK_STATE ]]; then
    { read -r previous; read -r previous_settings; } < "$CHECK_STATE"
  fi
  if is_integer "$previous" && [[ $previous_settings == "$snapshot" ]] \
      && (( now >= previous && now - previous < 10#$RETRY_MINUTES * 60 )); then
    return 1
  fi
  /bin/mkdir -p "${CHECK_STATE:h}" || return 1
  printf '%s\n%s\n' "$now" "$snapshot" > "$CHECK_STATE.tmp.$$" || return 1
  /bin/mv "$CHECK_STATE.tmp.$$" "$CHECK_STATE" || return 1
}

read_plist_value() {
  local plist_path=$1
  local key=$2
  /usr/bin/plutil -extract "$key" raw "$plist_path" 2>/dev/null
}

is_integer() {
  [[ ${1:-} == <-> ]]
}

installed_bundle_id() {
  read_plist_value "$APP_INFO" CFBundleIdentifier
}

installed_build() {
  read_plist_value "$APP_INFO" CFBundleVersion
}

installed_version() {
  read_plist_value "$APP_INFO" CFBundleShortVersionString
}

app_build_at() {
  local app_path=$1
  read_plist_value "$app_path/Contents/Info.plist" CFBundleVersion
}

app_version_at() {
  local app_path=$1
  read_plist_value "$app_path/Contents/Info.plist" CFBundleShortVersionString
}

app_bundle_id_at() {
  local app_path=$1
  read_plist_value "$app_path/Contents/Info.plist" CFBundleIdentifier
}

team_id_at() {
  local app_path=$1
  /usr/bin/codesign -dvvv "$app_path" 2>&1 \
    | /usr/bin/awk -F= '/^TeamIdentifier=/{print $2; exit}'
}

verify_app_identity() {
  local app_path=$1
  local description=$2
  local actual_bundle
  actual_bundle=$(app_bundle_id_at "$app_path" 2>/dev/null || true)

  if [[ $actual_bundle != "$BUNDLE_ID" ]]; then
    log_error "$description has bundle ID '${actual_bundle:-unreadable}', expected '$BUNDLE_ID'."
    return 1
  fi

  if [[ $SKIP_SIGNATURE_CHECK == 1 ]]; then
    log_info "Skipping signature validation for $description because the test override is enabled."
    return 0
  fi

  local actual_team
  actual_team=$(team_id_at "$app_path" 2>/dev/null || true)
  if [[ $actual_team != "$EXPECTED_TEAM_ID" ]]; then
    log_error "$description has signing team '${actual_team:-unreadable}', expected '$EXPECTED_TEAM_ID'."
    return 1
  fi

  if ! /usr/bin/codesign --verify --deep --strict "$app_path" >/dev/null 2>&1; then
    log_error "$description failed strict code-signature verification."
    return 1
  fi
}

find_newest_staged_update() {
  STAGED_APP=""
  STAGED_INFO=""
  STAGED_BUILD=0
  STAGED_VERSION=""

  local candidate_info candidate_build candidate_version candidate_app
  for candidate_info in "$SPARKLE_INSTALL_DIR"/**/"$APP_NAME"/Contents/Info.plist(N); do
    candidate_build=$(read_plist_value "$candidate_info" CFBundleVersion 2>/dev/null || true)
    candidate_version=$(read_plist_value "$candidate_info" CFBundleShortVersionString 2>/dev/null || true)
    candidate_app=${candidate_info%/Contents/Info.plist}

    if is_integer "$candidate_build" && (( candidate_build > STAGED_BUILD )); then
      STAGED_APP=$candidate_app
      STAGED_INFO=$candidate_info
      STAGED_BUILD=$candidate_build
      STAGED_VERSION=$candidate_version
    fi
  done
}

is_app_running() {
  if [[ -n ${CODEX_UPDATE_HELPER_RUNNING_OVERRIDE:-} ]]; then
    [[ $CODEX_UPDATE_HELPER_RUNNING_OVERRIDE == 1 ]]
    return
  fi
  # -a includes ancestor processes, which matters when the command is run
  # from Codex's own integrated terminal or automation environment.
  /usr/bin/pgrep -a -f -x "$APP_EXECUTABLE" >/dev/null 2>&1
}

quit_guard_ready() {
  [[ -x $QUIT_HELPER ]] && "$QUIT_HELPER" --check-accessibility >/dev/null 2>&1
}

running_app_pid() {
  /usr/bin/pgrep -a -f -x "$APP_EXECUTABLE" 2>/dev/null
}

request_guarded_quit() {
  "$QUIT_HELPER" --quit "$1" "$APP_EXECUTABLE" "$BUNDLE_ID" "$RESTART_POLICY"
}

wait_for_poll() {
  /bin/sleep "$POLL_SECONDS"
}

idle_seconds() {
  if [[ -n ${CODEX_UPDATE_HELPER_IDLE_SECONDS_OVERRIDE:-} ]]; then
    /bin/echo "$CODEX_UPDATE_HELPER_IDLE_SECONDS_OVERRIDE"
    return 0
  fi

  local idle_ns
  idle_ns=$(/usr/sbin/ioreg -r -c IOHIDSystem 2>/dev/null \
    | /usr/bin/awk '/"HIDIdleTime"/ {print $NF; exit}')
  if ! is_integer "$idle_ns"; then
    return 1
  fi
  /bin/echo $(( idle_ns / 1000000000 ))
}

read_preference() {
  local key=$1
  /usr/bin/defaults read "$BUNDLE_ID" "$key" 2>/dev/null
}

enable_automatic_updates() {
  local key current
  for key in SUEnableAutomaticChecks SUAutomaticallyUpdate; do
    current=$(read_preference "$key" || true)
    if [[ $current == 1 ]]; then
      continue
    fi

    if [[ $DRY_RUN == true ]]; then
      log_info "Would enable Codex preference $key."
    elif /usr/bin/defaults write "$BUNDLE_ID" "$key" -bool true; then
      log_info "Enabled Codex preference $key."
    else
      log_error "Could not enable Codex preference $key."
      return 1
    fi
  done
}

service_is_loaded() {
  /bin/launchctl print "gui/$UID/$SERVICE_LABEL" >/dev/null 2>&1
}

release_lock() {
  if [[ $LOCK_HELD == true ]]; then
    /bin/rm -f "$LOCK_DIR/pid"
    /bin/rmdir "$LOCK_DIR" 2>/dev/null || true
    LOCK_HELD=false
  fi
}

acquire_lock() {
  if /bin/mkdir "$LOCK_DIR" 2>/dev/null; then
    /bin/echo $$ > "$LOCK_DIR/pid"
    LOCK_HELD=true
    return 0
  fi

  local existing_pid=""
  if [[ -r "$LOCK_DIR/pid" ]]; then
    existing_pid=$(<"$LOCK_DIR/pid")
  fi
  if is_integer "$existing_pid" && /bin/kill -0 "$existing_pid" 2>/dev/null; then
    log_info "Another update check is already running as process $existing_pid."
    return 1
  fi

  /bin/rm -f "$LOCK_DIR/pid"
  /bin/rmdir "$LOCK_DIR" 2>/dev/null || true
  if /bin/mkdir "$LOCK_DIR" 2>/dev/null; then
    /bin/echo $$ > "$LOCK_DIR/pid"
    LOCK_HELD=true
    return 0
  fi

  log_error "Could not acquire the update lock at $LOCK_DIR."
  return 1
}

poll_count() {
  local max_wait=$MAX_WAIT_SECONDS
  local poll=$POLL_SECONDS
  if ! is_integer "$max_wait" || ! is_integer "$poll" || (( poll == 0 )); then
    /bin/echo 1
    return
  fi
  local count=$(( max_wait / poll ))
  (( count < 1 )) && count=1
  /bin/echo "$count"
}

open_app_if_needed() {
  local was_running=$1
  if [[ $REOPEN == true && $was_running == true ]] && ! is_app_running; then
    if /usr/bin/open -a "$APP_PATH"; then
      log_info "Reopened Codex."
    else
      log_error "The update finished, but Codex could not be reopened."
      return 1
    fi
  fi
}

run_update() {
  local attempt candidate_build current_build_value updated_build updated_version

  while (( $# > 0 )); do
    case $1 in
      --dry-run) DRY_RUN=true ;;
      --force) FORCE=true ;;
      --scheduled) SCHEDULED=true ;;
      *) log_error "Unknown option: $1"; usage >&2; return 2 ;;
    esac
    shift
  done

  if [[ $(uname -s) != Darwin ]]; then
    log_error "This utility only supports macOS."
    return 1
  fi

  if [[ ! -r $APP_INFO ]]; then
    log_error "Codex is not installed at $APP_PATH."
    return 1
  fi

  if [[ $FORCE != true ]]; then
    local window_result=0
    in_update_window || window_result=$?
    if (( window_result == 2 )); then
      return 1
    elif (( window_result != 0 )); then
      [[ $SCHEDULED == true ]] || log_info "Outside update window ($UPDATE_START_TIME–$UPDATE_END_TIME $UPDATE_TIMEZONE); deferring."
      return 0
    fi
  fi

  local bundle installed_build_value installed_version_value
  bundle=$(installed_bundle_id 2>/dev/null || true)
  installed_build_value=$(installed_build 2>/dev/null || true)
  installed_version_value=$(installed_version 2>/dev/null || true)

  if [[ $bundle != "$BUNDLE_ID" ]]; then
    log_error "The app at $APP_PATH has bundle ID '${bundle:-unreadable}', expected '$BUNDLE_ID'."
    return 1
  fi
  if ! is_integer "$installed_build_value"; then
    log_error "Could not read the installed Codex build number."
    return 1
  fi

  if ! acquire_lock; then
    return 0
  fi
  trap release_lock EXIT INT TERM HUP
  scheduled_check_due || return 0

  enable_automatic_updates || return 1
  find_newest_staged_update

  if (( STAGED_BUILD <= installed_build_value )); then
    log_info "No staged update is newer than Codex $installed_version_value (build $installed_build_value)."
    return 0
  fi

  log_info "Signed-update candidate: Codex $STAGED_VERSION (build $STAGED_BUILD); installed build is $installed_build_value."
  verify_app_identity "$APP_PATH" "Installed Codex" || return 1
  verify_app_identity "$STAGED_APP" "Staged Codex update" || return 1

  local was_running=false current_idle
  if is_app_running; then
    was_running=true
    if [[ $FORCE != true && $RESTART_POLICY == idle-only ]]; then
      current_idle=$(idle_seconds 2>/dev/null || true)
      if ! is_integer "$current_idle"; then
        log_info "Could not determine keyboard/mouse idle time; deferring the update safely."
        return 0
      fi
      if ! is_integer "$MIN_IDLE_SECONDS" || (( current_idle < MIN_IDLE_SECONDS )); then
        log_info "Codex is open and the Mac has been idle for ${current_idle}s; deferring until ${MIN_IDLE_SECONDS}s."
        return 0
      fi
    fi

    if [[ $DRY_RUN == true ]]; then
      log_info "Would request a graceful Codex quit (restart policy: $RESTART_POLICY; reopen: $REOPEN), then wait for Sparkle."
      if ! quit_guard_ready; then
        log_info "Unattended quit is not ready: install the local helper and enable its Accessibility permission."
      fi
      return 0
    fi

    if ! quit_guard_ready; then
      log_info "Unattended quit requires Codex Updater Accessibility permission; deferring before requesting a quit."
      return 0
    fi
    # Signature verification can take several seconds. Recheck the window and
    # keyboard/mouse activity immediately before asking the app to quit.
    if [[ $FORCE != true ]]; then
      in_update_window || { log_info "Update window closed; deferring."; return 0; }
      if [[ $RESTART_POLICY == idle-only ]]; then
        current_idle=$(idle_seconds 2>/dev/null || true)
        if ! is_integer "$current_idle" || (( current_idle < MIN_IDLE_SECONDS )); then
          log_info "The Mac became active; deferring."
          return 0
        fi
      fi
    fi
    local app_pid quit_result=0
    app_pid=$(running_app_pid) || return 0
    if ! is_integer "$app_pid"; then
      log_info "Could not identify one Codex process; deferring."
      return 0
    fi
    log_info "Requesting a guarded graceful Codex quit so Sparkle can install the update."
    request_guarded_quit "$app_pid" || quit_result=$?
    if (( quit_result != 0 )); then
      log_info "Codex quit was deferred by the guard (result $quit_result); no forced termination."
      return 0
    fi

    for attempt in {1..$(poll_count)}; do
      current_build_value=$(installed_build 2>/dev/null || true)
      if is_integer "$current_build_value" && (( current_build_value > installed_build_value )); then
        break
      fi
      if ! is_app_running; then
        break
      fi
      wait_for_poll
    done

    current_build_value=$(installed_build 2>/dev/null || true)
    if is_app_running \
        && { ! is_integer "$current_build_value" || (( current_build_value <= installed_build_value )); }; then
      log_info "Codex did not quit within ${MAX_WAIT_SECONDS}s; deferring without forcing it closed."
      return 0
    fi
  else
    log_info "Codex is already closed; waiting for Sparkle to finish without reopening it."
    if [[ $DRY_RUN == true ]]; then
      log_info "Would wait for Sparkle to finish the staged update."
      return 0
    fi
  fi

  updated_build=$installed_build_value
  for attempt in {1..$(poll_count)}; do
    candidate_build=$(installed_build 2>/dev/null || true)
    if is_integer "$candidate_build" && (( candidate_build > installed_build_value )); then
      updated_build=$candidate_build
      break
    fi
    wait_for_poll
  done

  if (( updated_build > installed_build_value )); then
    updated_version=$(installed_version 2>/dev/null || true)
    log_info "Updated Codex to $updated_version (build $updated_build)."
    open_app_if_needed "$was_running"
  else
    log_error "Sparkle did not finish within ${MAX_WAIT_SECONDS}s; the existing app was left intact."
    open_app_if_needed "$was_running" || true
    return 1
  fi
}

show_status() {
  /bin/echo "$TOOL_NAME $TOOL_VERSION"
  /bin/echo "App path: $APP_PATH"
  /bin/echo "Update window: $UPDATE_START_TIME–$UPDATE_END_TIME $UPDATE_TIMEZONE"
  /bin/echo "Restart policy: $RESTART_POLICY; idle: ${MIN_IDLE_SECONDS}s; reopen: $REOPEN; retry: ${RETRY_MINUTES}m"
  /bin/echo "Settings: $SETTINGS_PATH"
  /bin/echo "Unattended quit: $(quit_guard_ready && /bin/echo ready || /bin/echo 'needs helper Accessibility permission')"

  if [[ ! -r $APP_INFO ]]; then
    /bin/echo "Installed: not found"
    /bin/echo "Service: $(service_is_loaded && /bin/echo loaded || /bin/echo not-loaded)"
    return 1
  fi

  local version build automatic_checks automatic_updates skipped process_state service_state
  version=$(installed_version 2>/dev/null || /bin/echo unreadable)
  build=$(installed_build 2>/dev/null || /bin/echo unreadable)
  automatic_checks=$(read_preference SUEnableAutomaticChecks || /bin/echo unset)
  automatic_updates=$(read_preference SUAutomaticallyUpdate || /bin/echo unset)
  skipped=$(read_preference SUSkippedVersion || /bin/echo none)
  process_state=$(is_app_running && /bin/echo running || /bin/echo closed)
  service_state=$(service_is_loaded && /bin/echo loaded || /bin/echo not-loaded)
  find_newest_staged_update

  /bin/echo "Installed: $version (build $build)"
  if (( STAGED_BUILD > 0 )); then
    /bin/echo "Staged: $STAGED_VERSION (build $STAGED_BUILD)"
  else
    /bin/echo "Staged: none"
  fi
  /bin/echo "Automatic checks: $automatic_checks"
  /bin/echo "Automatic updates: $automatic_updates"
  /bin/echo "Skipped version: $skipped"
  /bin/echo "Codex process: $process_state"
  /bin/echo "Service: $service_state"
}

doctor_check() {
  local level=$1
  shift
  /bin/echo "[$level] $*"
}

run_doctor() {
  local errors=0 warnings=0
  /bin/echo "$TOOL_NAME doctor"

  if [[ $(uname -s) == Darwin ]]; then
    doctor_check OK "macOS detected."
  else
    doctor_check ERROR "This utility only supports macOS."
    (( errors++ ))
  fi

  if [[ -r $APP_INFO ]]; then
    doctor_check OK "Codex found at $APP_PATH."
  else
    doctor_check ERROR "Codex was not found at $APP_PATH."
    (( errors++ ))
  fi

  if [[ -r $APP_INFO ]]; then
    if verify_app_identity "$APP_PATH" "Installed Codex" >/dev/null; then
      doctor_check OK "Installed Codex has the expected bundle ID and signature."
    else
      doctor_check ERROR "Installed Codex identity or signature validation failed."
      (( errors++ ))
    fi
  fi

  if [[ -d $SPARKLE_INSTALL_DIR ]]; then
    doctor_check OK "Sparkle installation cache is available."
  else
    doctor_check WARN "Sparkle has not created its installation cache yet."
    (( warnings++ ))
  fi

  find_newest_staged_update
  if (( STAGED_BUILD > 0 )); then
    if verify_app_identity "$STAGED_APP" "Staged Codex update" >/dev/null; then
      doctor_check OK "Staged Codex $STAGED_VERSION (build $STAGED_BUILD) is signed correctly."
    else
      doctor_check ERROR "The staged Codex update failed identity or signature validation."
      (( errors++ ))
    fi
  else
    doctor_check OK "No staged Codex update is waiting."
  fi

  local checks updates skipped
  checks=$(read_preference SUEnableAutomaticChecks || /bin/echo unset)
  updates=$(read_preference SUAutomaticallyUpdate || /bin/echo unset)
  skipped=$(read_preference SUSkippedVersion || /bin/echo none)
  if [[ $checks == 1 && $updates == 1 ]]; then
    doctor_check OK "Codex automatic checks and downloads are enabled."
  else
    doctor_check WARN "Automatic update preferences are not both enabled; the next service run will enable them."
    (( warnings++ ))
  fi
  if [[ $skipped != none ]]; then
    doctor_check WARN "Codex is configured to skip version $skipped; this utility respects that choice."
    (( warnings++ ))
  fi

  if service_is_loaded; then
    doctor_check OK "Service $SERVICE_LABEL is loaded."
  else
    doctor_check WARN "Service $SERVICE_LABEL is not loaded."
    (( warnings++ ))
  fi

  if quit_guard_ready; then
    doctor_check OK "Unattended quit guard has Accessibility permission."
  else
    doctor_check WARN "Install the local helper and enable Codex Updater in System Settings > Privacy & Security > Accessibility. Updates defer until it is ready."
    (( warnings++ ))
  fi

  /bin/echo "Doctor finished with $errors error(s) and $warnings warning(s)."
  (( errors == 0 ))
}

main() {
  local command=${1:-run}
  (( $# > 0 )) && shift

  case $command in
    run|status|doctor) load_settings || return 1 ;;
  esac

  case $command in
    run) run_update "$@" ;;
    status) show_status ;;
    doctor) run_doctor ;;
    settings) "$QUIT_HELPER" --settings ;;
    config) "$QUIT_HELPER" --config "$@" ;;
    version|--version|-v) /bin/echo "$TOOL_VERSION" ;;
    help|--help|-h) usage ;;
    *) log_error "Unknown command: $command"; usage >&2; return 2 ;;
  esac
}

# Sourcing exposes functions for isolated tests without running an update.
if [[ $ZSH_EVAL_CONTEXT != *:file ]]; then
  main "$@"
fi
